RMT_PUBLIC_URL=https://rmt.example.com
RMT_HOST=127.0.0.1
RMT_PORT=3220
RMT_ADMIN_USERNAME=admin
# Generate using src/hash-password.mjs; replace the placeholder before starting.
RMT_ADMIN_PASSWORD_HASH=replace-with-scrypt-hash
# Keep outside the web/static directory and make readable only by the service user.
RMT_STATE_FILE=/var/lib/rmtagt/cloud.json
RMT_STATIC_DIR=/opt/rmtagt/services/rmtcdx/apps/bridge/web-dist
