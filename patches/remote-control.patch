@@ -0,0 +1,85 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { api } from "./client";
+
+test("executed request with lost response survives offline retry without a second execution", async () => {
+  const originalFetch = globalThis.fetch;
+  const originalWindow = Object.getOwnPropertyDescriptor(globalThis, "window");
+  const storage = new Map<string, string>();
+  Object.defineProperty(globalThis, "window", { configurable: true, value: {
+    location: { pathname: "/devices/windows/", search: "", assign: () => {} },
+    localStorage: {
+      getItem: (key: string) => storage.get(key) ?? null,
+      setItem: (key: string, value: string) => { storage.set(key, value); },
+      removeItem: (key: string) => { storage.delete(key); }
+    }
+  } });
+  const ids: string[] = [];
+  const executed = new Map<string, { run: { id: string } }>();
+  let attempt = 0;
+  globalThis.fetch = async (_input, init) => {
+    const id = new Headers(init?.headers).get("x-request-id")!;
+    ids.push(id);
+    attempt++;
+    if (attempt === 1) {
+      executed.set(id, { run: { id: "already-running-on-computer" } });
+      throw new TypeError("Response lost after dispatch");
+    }
+    if (attempt === 2) return Response.json({ message: "Device offline", state: "offline" }, { status: 503 });
+    if (!executed.has(id)) executed.set(id, { run: { id: "duplicate-execution" } });
+    return Response.json(executed.get(id));
+  };
+  try {
+    const payload = { repoId: "isolated", prompt: "safe prompt" };
+    await assert.rejects(api.startRun(payload), /outcome unknown/);
+    await assert.rejects(api.startRun(payload), /Device offline/);
+    assert.equal((await api.startRun(payload)).run.id, "already-running-on-computer");
+    assert.equal(new Set(ids).size, 1);
+    assert.equal(executed.size, 1);
+    assert.equal(storage.size, 0, "Only a confirmed result clears the receipt");
+  } finally {
+    globalThis.fetch = originalFetch;
+    if (originalWindow) Object.defineProperty(globalThis, "window", originalWindow);
+    else Reflect.deleteProperty(globalThis, "window");
+  }
+});
+
+test("only matching durable terminal rejection releases an ID for the next user intent", async () => {
+  const originalFetch = globalThis.fetch;
+  const originalWindow = Object.getOwnPropertyDescriptor(globalThis, "window");
+  const storage = new Map<string, string>();
+  Object.defineProperty(globalThis, "window", { configurable: true, value: {
+    location: { pathname: "/devices/mac/", search: "", assign: () => {} },
+    localStorage: {
+      getItem: (key: string) => storage.get(key) ?? null,
+      setItem: (key: string, value: string) => { storage.set(key, value); },
+      removeItem: (key: string) => { storage.delete(key); }
+    }
+  } });
+  const ids: string[] = [];
+  let attempt = 0;
+  globalThis.fetch = async (_input, init) => {
+    const id = new Headers(init?.headers).get("x-request-id")!;
+    ids.push(id);
+    attempt++;
+    if (attempt === 1) return Response.json({ message: "Login required" }, { status: 401 });
+    if (attempt === 2) return Response.json({ message: "Cannot archive a session with an active run" }, {
+      status: 409, headers: { "x-rmtagt-receipt": "complete", "x-request-id": "mismatched-request-id" }
+    });
+    if (attempt === 3) return Response.json({ message: "Cannot archive a session with an active run" }, {
+      status: 409, headers: { "x-rmtagt-receipt": "complete", "x-request-id": id }
+    });
+    return Response.json({ session: { id: "archived" } });
+  };
+  try {
+    for (let i = 0; i < 3; i++) await assert.rejects(api.archiveSession("test-session"));
+    assert.equal(new Set(ids).size, 1, "Relay errors and mismatched receipts cannot release a pending operation");
+    assert.equal(storage.size, 0, "Executor confirmed terminal failure resolves the old intent");
+    await api.archiveSession("test-session");
+    assert.notEqual(ids[3], ids[2], "User can archive again after the active run ends");
+  } finally {
+    globalThis.fetch = originalFetch;
+    if (originalWindow) Object.defineProperty(globalThis, "window", originalWindow);
+    else Reflect.deleteProperty(globalThis, "window");
+  }
+});
