@@ -0,0 +1,32 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { RealCodexClient } from "../../src/codex/real-client";
+
+test("concurrent identical thread scans share pagination without caching completed or failed results", async () => {
+  const client = new RealCodexClient({ info() {}, warn() {}, error() {}, debug() {} });
+  Reflect.set(client, "ensureReady", async () => {});
+  const calls: Array<{ archived: boolean; cursor: string | null }> = [];
+  let fail = false;
+  Reflect.set(client, "request", async (_method: string, params: { archived: boolean; cursor: string | null }) => {
+    calls.push(params);
+    await new Promise(resolve => setTimeout(resolve, 5));
+    if (fail) throw new Error("Scan unavailable");
+    return { data: [{ id: params.cursor ?? "first" }], nextCursor: params.cursor ? null : "second" };
+  });
+  const [first, duplicate, archived] = await Promise.all([
+    client.listThreads(), client.listThreads({ archived: false }), client.listThreads({ archived: true })
+  ]);
+  assert.deepEqual(first.map(thread => thread.id), ["first", "second"]);
+  assert.strictEqual(first, duplicate);
+  assert.notStrictEqual(first, archived);
+  assert.equal(calls.length, 4, "Each distinct filter scans two pages once");
+  await client.listThreads();
+  assert.equal(calls.length, 6, "Later reads must obtain fresh native metadata");
+  fail = true;
+  const failures = await Promise.allSettled([client.listThreads(), client.listThreads()]);
+  assert(failures.every(result => result.status === "rejected"));
+  assert.equal(calls.length, 7);
+  fail = false;
+  await client.listThreads();
+  assert.equal(calls.length, 9, "Failed scans cannot poison subsequent reads");
+});
