+  const thread: CodexThread = { ...fixture, cwd: process.cwd(), turns: [] };
+  for (const unavailable of ["includeTurns is unavailable before first user message", "list_turns is not supported yet"]) {
+    class EmptyThreadBackend extends FixtureCodexBackend {
+      override async createThread() { return { threadId: thread.id }; }
+      override async readThread(id: string, options?: { includeTurns?: boolean }) {
+        if (options?.includeTurns) throw new Error(unavailable);
+        return super.readThread(id, options);
+      }
+    }
+    const catalog = new LiveCatalogService(new EmptyThreadBackend([thread]), [
+      { id: "empty-session", name: "Compatibility", path: process.cwd(), pinned: true }
