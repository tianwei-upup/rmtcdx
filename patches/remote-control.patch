@@ -0,0 +1,299 @@
+import crypto from "node:crypto";
+import net from "node:net";
+import { EventEmitter } from "node:events";
+
+const MAGIC = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
+const MAX_FRAME_BYTES = 64 * 1024 * 1024;
+
+export type WebSocketClientOptions = {
+  url: string;
+  socketPath?: string;
+  headers?: Record<string, string>;
+  handshakeTimeoutMs?: number;
+  maxPayloadBytes?: number;
+};
+
+type Frame = { opcode: number; payload: Buffer; fin: boolean };
+
+function encodeFrame(opcode: number, payload: Buffer): Buffer {
+  const length = payload.length;
+  let header: Buffer;
+  if (length < 126) {
+    header = Buffer.alloc(6);
+    header[1] = 0x80 | length;
+  } else if (length < 65536) {
+    header = Buffer.alloc(8);
+    header[1] = 0x80 | 126;
+    header.writeUInt16BE(length, 2);
+  } else {
+    header = Buffer.alloc(14);
+    header[1] = 0x80 | 127;
+    header.writeBigUInt64BE(BigInt(length), 2);
+  }
+  header[0] = 0x80 | opcode;
+  const mask = crypto.randomBytes(4);
+  mask.copy(header, header.length - 4);
+  const masked = Buffer.allocUnsafe(length);
+  for (let index = 0; index < length; index += 1) {
+    masked[index] = payload[index]! ^ mask[index % 4]!;
+  }
+  return Buffer.concat([header, masked]);
+}
+
+/** Parses exactly one frame starting at `offset`; returns null when incomplete. */
+function decodeFrame(buffer: Buffer, offset: number): { frame: Frame; next: number } | null {
+  if (buffer.length - offset < 2) {
+    return null;
+  }
+  const first = buffer[offset]!;
+  const second = buffer[offset + 1]!;
+  const fin = (first & 0x80) !== 0;
+  const opcode = first & 0x0f;
+  const masked = (second & 0x80) !== 0;
+  let length = second & 0x7f;
+  let cursor = offset + 2;
+  if (length === 126) {
+    if (buffer.length - cursor < 2) {
+      return null;
+    }
+    length = buffer.readUInt16BE(cursor);
+    cursor += 2;
+  } else if (length === 127) {
+    if (buffer.length - cursor < 8) {
+      return null;
+    }
+    const wide = buffer.readBigUInt64BE(cursor);
+    if (wide > BigInt(MAX_FRAME_BYTES)) {
+      throw new Error("websocket_frame_too_large");
+    }
+    length = Number(wide);
+    cursor += 8;
+  }
+  let maskKey: Buffer | null = null;
+  if (masked) {
+    if (buffer.length - cursor < 4) {
+      return null;
+    }
+    maskKey = buffer.subarray(cursor, cursor + 4);
+    cursor += 4;
+  }
+  if (buffer.length - cursor < length) {
+    return null;
+  }
+  const raw = buffer.subarray(cursor, cursor + length);
+  const payload = maskKey ? Buffer.from(raw) : Buffer.from(raw);
+  if (maskKey) {
+    for (let index = 0; index < payload.length; index += 1) {
+      payload[index] = payload[index]! ^ maskKey[index % 4]!;
+    }
+  }
+  return { frame: { opcode, payload, fin }, next: cursor + length };
+}
+
+/**
+ * Minimal RFC 6455 client used only for the attach path.
+ *
+ * It exists so the transport can dial a Unix socket without pulling a runtime
+ * dependency into the service bundle. It supports text frames, fragmentation,
+ * ping/pong and close, which is the whole surface a local Codex app-server
+ * RPC channel needs; it deliberately does not negotiate extensions.
+ */
+export class WebSocketClient extends EventEmitter {
+  private socket: net.Socket | null = null;
+  private buffer = Buffer.alloc(0);
+  private fragments: Buffer[] = [];
+  private fragmentOpcode = 0;
+  private closed = false;
+
+  constructor(private readonly options: WebSocketClientOptions) {
+    super();
+  }
+
+  get alive(): boolean {
+    return this.socket !== null && !this.socket.destroyed && !this.closed;
+  }
+
+  async connect(): Promise<void> {
+    const url = new URL(this.options.url);
+    const secure = url.protocol === "wss:";
+    const host = url.hostname || "localhost";
+    const port = url.port ? Number(url.port) : secure ? 443 : 80;
+    const target = this.options.socketPath
+      ? this.options.socketPath
+      : secure
+        ? { host, port }
+        : { host, port };
+    const timeout = this.options.handshakeTimeoutMs ?? 5000;
+    const key = crypto.randomBytes(16).toString("base64");
+
+    const socket = this.options.socketPath
+      ? net.createConnection({ path: target as string })
+      : net.createConnection({ host, port: port });
+    if (secure) {
+      socket.destroy();
+      throw new Error("wss_not_supported");
+    }
+    this.socket = socket;
+    socket.setNoDelay(true);
+
+    await new Promise<void>((resolve, reject) => {
+      const timer = setTimeout(() => {
+        socket.destroy();
+        reject(new Error("websocket_handshake_timeout"));
+      }, timeout);
+      timer.unref?.();
+
+      const fail = (error: Error): void => {
+        clearTimeout(timer);
+        socket.destroy();
+        reject(error);
+      };
+
+      socket.once("error", fail);
+      socket.once("connect", () => {
+        const path = url.pathname && url.pathname !== "" ? url.pathname : "/rpc";
+        const lines = [
+          `GET ${path} HTTP/1.1`,
+          `Host: ${this.options.socketPath ? "localhost" : url.host}`,
+          "Upgrade: websocket",
+          "Connection: Upgrade",
+          `Sec-WebSocket-Key: ${key}`,
+          "Sec-WebSocket-Version: 13"
+        ];
+        for (const [name, value] of Object.entries(this.options.headers ?? {})) {
+          lines.push(`${name}: ${value}`);
+        }
+        socket.write(lines.join("\r\n") + "\r\n\r\n");
+      });
+
+      let handshake = Buffer.alloc(0);
+      const onHandshakeData = (chunk: Buffer): void => {
+        handshake = Buffer.concat([handshake, chunk]);
+        const end = handshake.indexOf("\r\n\r\n");
+        if (end < 0) {
+          if (handshake.length > 65536) {
+            fail(new Error("websocket_handshake_too_large"));
+          }
+          return;
+        }
+        socket.removeListener("data", onHandshakeData);
+        socket.removeListener("error", fail);
+        const head = handshake.subarray(0, end).toString("utf8");
+        const status = Number(head.split("\r\n")[0]?.split(" ")[1] ?? 0);
+        if (status !== 101) {
+          fail(new Error(`websocket_upgrade_rejected_${status}`));
+          return;
+        }
+        const accept = /sec-websocket-accept:\s*(\S+)/i.exec(head)?.[1];
+        const expected = crypto.createHash("sha1").update(key + MAGIC).digest("base64");
+        if (accept !== expected) {
+          fail(new Error("websocket_accept_mismatch"));
+          return;
+        }
+        clearTimeout(timer);
+        this.buffer = handshake.subarray(end + 4);
+        socket.on("data", (data: Buffer) => this.onData(data));
+        socket.on("error", (error: Error) => {
+          this.emit("error", error);
+        });
+        socket.on("close", () => {
+          this.closed = true;
+          this.socket = null;
+          this.emit("close", 1006, "");
+        });
+        // Frames may already have arrived alongside the handshake response.
+        if (this.buffer.length) {
+          const pendingFrame = this.buffer;
+          this.buffer = Buffer.alloc(0);
+          this.consume(pendingFrame);
+        }
+        this.emit("open");
+        resolve();
+      };
+      socket.on("data", onHandshakeData);
+    });
+  }
+
+  private onData(chunk: Buffer): void {
+    try {
+      this.consume(chunk);
+    } catch (error) {
+      this.emit("error", error instanceof Error ? error : new Error(String(error)));
+      this.close();
+    }
+  }
+
+  private consume(chunk: Buffer): void {
+    this.buffer = Buffer.concat([this.buffer, chunk]);
+    const limit = this.options.maxPayloadBytes ?? 2 * 1024 * 1024;
+    for (;;) {
+      const decoded = decodeFrame(this.buffer, 0);
+      if (!decoded) {
+        if (this.buffer.length > limit) {
+          throw new Error("websocket_payload_limit");
+        }
+        return;
+      }
+      this.buffer = this.buffer.subarray(decoded.next);
+      const { frame } = decoded;
+      if (frame.opcode === 0x9) {
+        this.socket?.write(encodeFrame(0xa, frame.payload));
+        continue;
+      }
+      if (frame.opcode === 0xa) {
+        continue;
+      }
+      if (frame.opcode === 0x8) {
+        this.closed = true;
+        this.socket?.end(encodeFrame(0x8, Buffer.alloc(0)));
+        this.emit("close", 1000, "");
+        continue;
+      }
+      if (frame.opcode === 0x0) {
+        this.fragments.push(frame.payload);
+        if (frame.fin) {
+          this.deliver(this.fragmentOpcode, Buffer.concat(this.fragments));
+          this.fragments = [];
+          this.fragmentOpcode = 0;
+        }
+        continue;
+      }
+      if (!frame.fin) {
+        this.fragmentOpcode = frame.opcode;
+        this.fragments = [frame.payload];
+        continue;
+      }
+      this.deliver(frame.opcode, frame.payload);
+    }
+  }
+
+  private deliver(opcode: number, payload: Buffer): void {
+    if (opcode === 0x1) {
+      this.emit("message", payload.toString("utf8"));
+    }
+  }
+
+  send(text: string): void {
+    const socket = this.socket;
+    if (!socket || this.closed) {
+      throw new Error("websocket_not_open");
+    }
+    socket.write(encodeFrame(0x1, Buffer.from(text, "utf8")));
+  }
+
+  close(): void {
+    const socket = this.socket;
+    this.closed = true;
+    if (!socket) {
+      return;
+    }
+    try {
+      socket.write(encodeFrame(0x8, Buffer.alloc(0)));
+    } catch {
+      // The peer may already be gone.
+    }
+    socket.end();
+    socket.destroy();
+    this.socket = null;
+  }
+}
diff --git a/apps/bridge/test/codex-compat/attach-transport.test.ts b/apps/bridge/test/codex-compat/attach-transport.test.ts
