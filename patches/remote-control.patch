--- /dev/null
+++ b/apps/bridge/src/codex/transport.ts
@@ -0,0 +1,265 @@
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+import { EventEmitter } from "node:events";
+
+import type { LoggerLike } from "./types";
+import type { CodexDebugLog } from "../observability/codex-debug-log";
+import { createCodexProcessEnv } from "./process-env";
+import { WebSocketClient } from "./websocket-client";
+
+/**
+ * Transport seam for the Codex app-server JSON-RPC session.
+ *
+ * The client owns protocol semantics (request bookkeeping, event projection,
+ * pending server requests). The transport only owns the byte channel, so the
+ * same client can run over a child process stdio pipe or an already-running
+ * app-server reachable over a Unix socket / WebSocket endpoint.
+ */
+export interface CodexTransport extends EventEmitter {
+  connect(): Promise<void>;
+  disconnect(): void;
+  sendLine(line: string): void;
+  readonly alive: boolean;
+  readonly pid: number | null;
+}
+
+export interface StdioTransportOptions {
+  logger: LoggerLike;
+  debugLog?: CodexDebugLog;
+  codexHomeDir?: string;
+}
+
+/**
+ * Spawns its own `codex app-server` child process. This is the original bridge
+ * behaviour and the only transport that creates a Codex process; it must keep
+ * going through the isolated-runtime guard at the call site.
+ */
+export class StdioTransport extends EventEmitter implements CodexTransport {
+  private child: ChildProcessWithoutNullStreams | null = null;
+
+  constructor(private readonly options: StdioTransportOptions) {
+    super();
+  }
+
+  get alive(): boolean {
+    return this.child !== null && !this.child.killed;
+  }
+
+  get pid(): number | null {
+    return this.child?.pid ?? null;
+  }
+
+  async connect(): Promise<void> {
+    this.spawnChild();
+  }
+
+  disconnect(): void {
+    if (this.child) {
+      this.child.kill();
+      this.child = null;
+    }
+  }
+
+  sendLine(line: string): void {
+    if (!this.child?.stdin.writable) {
+      this.options.debugLog?.write("stdin.unwritable", {
+        pid: this.child?.pid ?? null
+      });
+      throw new Error("Codex app-server stdin is not writable");
+    }
+    this.child.stdin.write(line);
+  }
+
+  private spawnChild() {
+    const { logger, debugLog, codexHomeDir } = this.options;
+    const childEnv = createCodexProcessEnv(process.env, {
+      codexHomeDir
+    });
+    debugLog?.write("child.spawn.request", {
+      command: "codex",
+      args: ["app-server", "--listen", "stdio://"],
+      codexHomeDir: codexHomeDir ?? null
+    });
+    const child = spawn("codex", ["app-server", "--listen", "stdio://"], {
+      stdio: ["pipe", "pipe", "pipe"],
+      env: childEnv
+    });
+    this.child = child;
+
+    child.on("spawn", () => {
+      debugLog?.write("child.spawn", {
+        pid: child.pid ?? null
+      });
+      this.emit("spawn");
+    });
+
+    child.on("error", (error) => {
+      debugLog?.write("child.error", {
+        pid: child.pid ?? null,
+        error
+      });
+      logger.error(error.message);
+      this.emit("error", error);
+    });
+
+    child.stdout.setEncoding("utf8");
+    child.stdout.on("data", (chunk: string) => {
+      this.emit("data", chunk);
+    });
+
+    child.stderr.setEncoding("utf8");
+    child.stderr.on("data", (chunk: string) => {
+      const text = chunk.trim();
+      if (text) {
+        debugLog?.write("child.stderr", {
+          pid: child.pid ?? null,
+          text
+        });
+        logger.warn(text);
+      }
+    });
+    child.stdout.on("close", () => {
+      debugLog?.write("child.stdout.closed", {
+        pid: child.pid ?? null
+      });
+    });
+    child.stderr.on("close", () => {
+      debugLog?.write("child.stderr.closed", {
+        pid: child.pid ?? null
+      });
+    });
+
+    child.on("close", (code, signal) => {
+      debugLog?.write("child.close", {
+        pid: child.pid ?? null,
+        code: code ?? null,
+        signal: signal ?? null
+      });
+    });
+
+    child.on("exit", (code, signal) => {
+      const pid = child.pid ?? null;
+      this.child = null;
+      debugLog?.write("child.exit", {
+        pid,
+        code: code ?? null,
+        signal: signal ?? null
+      });
+      this.emit("exit", { code, signal });
+    });
+  }
+}
+
+export interface WebSocketTransportOptions {
+  /** Full websocket URL, e.g. `ws://localhost/rpc`. */
+  url: string;
+  /** Unix socket to dial instead of TCP. Used by the Codex shared daemon. */
+  socketPath?: string;
+  logger?: LoggerLike;
+  debugLog?: CodexDebugLog;
+  handshakeTimeoutMs?: number;
+  maxPayloadBytes?: number;
+}
+
+/**
+ * Attach-only transport. It never spawns a Codex process and never touches
+ * CODEX_HOME; the caller must have already validated the endpoint (ownership,
+ * permissions, alias, version) before constructing this.
+ *
+ * `Idle` is considered alive: the WebSocket handshake is asynchronous, while
+ * the stdio transport is writable immediately after `connect()`. The client
+ * always opens the transport first and only then starts `initialize()`, so
+ * lines written before the handshake settles are queued and flushed on open
+ * instead of being treated as a dead endpoint.
+ */
+export class WebSocketTransport extends EventEmitter implements CodexTransport {
+  private socket: WebSocketClient | null = null;
+  private state: "idle" | "connecting" | "open" | "closed" = "idle";
+  private queued: string[] = [];
+
+  constructor(private readonly options: WebSocketTransportOptions) {
+    super();
+  }
+
+  get alive(): boolean {
+    // `connecting` counts as alive: outbound lines are queued until the
+    // handshake settles, so the channel is usable rather than dead.
+    return this.state !== "closed";
+  }
+
+  get pid(): number | null {
+    return null;
+  }
+
+  async connect(): Promise<void> {
+    const { url, socketPath, handshakeTimeoutMs = 5000, maxPayloadBytes = 2 * 1024 * 1024 } = this.options;
+    const socket = new WebSocketClient({ url, socketPath, handshakeTimeoutMs, maxPayloadBytes });
+    this.socket = socket;
+    this.state = "connecting";
+
+    socket.on("message", (data: unknown) => {
+      // The client frames the channel as newline-delimited JSON. A peer that
+      // sends bare JSON objects would otherwise stall every request, so
+      // framing is normalised here rather than left to each peer.
+      const text = String(data);
+      this.emit("data", text.endsWith("\n") ? text : `${text}\n`);
+    });
+    socket.on("error", (error: unknown) => {
+      const value = error instanceof Error ? error : new Error(String(error));
+      this.options.debugLog?.write("transport.websocket.error", { message: value.message });
+      this.emit("error", value);
+    });
+    socket.on("close", (code: unknown, reason: unknown) => {
+      if (this.socket === socket) {
+        this.socket = null;
+      }
+      const wasOpen = this.state === "open";
+      this.state = "closed";
+      this.queued = [];
+      // A failed handshake surfaces through connect(); emitting exit as well
+      // would make the client report a second, spurious backend loss.
+      if (wasOpen) {
+        this.emit("exit", { code: typeof code === "number" ? code : null, signal: null });
+      }
+      this.options.debugLog?.write("transport.websocket.close", {
+        code: typeof code === "number" ? code : null,
+        reason: String(reason ?? "")
+      });
+    });
+
+    try {
+      await socket.connect();
+    } catch (error) {
+      this.state = "closed";
+      this.queued = [];
+      this.socket = null;
+      socket.close();
+      throw error;
+    }
+    this.state = "open";
+    for (const line of this.queued) {
+      socket.send(line);
+    }
+    this.queued = [];
+    this.emit("spawn");
+  }
+
+  disconnect(): void {
+    const socket = this.socket;
+    this.socket = null;
+    this.state = "closed";
+    this.queued = [];
+    socket?.close();
+  }
+
+  sendLine(line: string): void {
+    if (this.state === "idle" || this.state === "connecting") {
+      this.queued.push(line);
+      return;
+    }
+    const socket = this.socket;
+    if (this.state !== "open" || !socket || !socket.alive) {
+      throw new Error("Codex app-server transport is not writable");
+    }
+    socket.send(line);
+  }
+}
