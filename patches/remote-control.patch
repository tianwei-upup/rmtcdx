--- /dev/null
+++ b/apps/bridge/test/codex-compat/attach-transport.test.ts
@@ -0,0 +1,377 @@
+import assert from "node:assert/strict";
+import crypto from "node:crypto";
+import fs from "node:fs";
+import net from "node:net";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+
+import { createAttachClient } from "../../src/business-attach";
+import { WebSocketClient } from "../../src/codex/websocket-client";
+
+const MAGIC = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
+const silent = { info() {}, warn() {}, error() {}, debug() {} };
+
+type Frame = { opcode: number; payload: Buffer; fin: boolean };
+
+function encodeFrame(opcode: number, payload: Buffer, fin = true, mask = false): Buffer {
+  const length = payload.length;
+  let header: Buffer;
+  if (length < 126) {
+    header = Buffer.alloc(2);
+    header[1] = length;
+  } else if (length < 65536) {
+    header = Buffer.alloc(4);
+    header[1] = 126;
+    header.writeUInt16BE(length, 2);
+  } else {
+    header = Buffer.alloc(10);
+    header[1] = 127;
+    header.writeBigUInt64BE(BigInt(length), 2);
+  }
+  header[0] = (fin ? 0x80 : 0) | opcode;
+  if (!mask) {
+    return Buffer.concat([header, payload]);
+  }
+  const key = crypto.randomBytes(4);
+  header[1] |= 0x80;
+  header = Buffer.concat([header, key]);
+  const masked = Buffer.alloc(length);
+  for (let index = 0; index < length; index += 1) {
+    masked[index] = payload[index]! ^ key[index % 4]!;
+  }
+  return Buffer.concat([header, masked]);
+}
+
+function decodeFrame(buffer: Buffer, offset: number): { frame: Frame; next: number } | null {
+  if (buffer.length - offset < 2) return null;
+  const first = buffer[offset]!;
+  const second = buffer[offset + 1]!;
+  const fin = (first & 0x80) !== 0;
+  const opcode = first & 0x0f;
+  const masked = (second & 0x80) !== 0;
+  let length = second & 0x7f;
+  let cursor = offset + 2;
+  if (length === 126) {
+    if (buffer.length - cursor < 2) return null;
+    length = buffer.readUInt16BE(cursor);
+    cursor += 2;
+  } else if (length === 127) {
+    if (buffer.length - cursor < 8) return null;
+    length = Number(buffer.readBigUInt64BE(cursor));
+    cursor += 8;
+  }
+  let key: Buffer | null = null;
+  if (masked) {
+    if (buffer.length - cursor < 4) return null;
+    key = buffer.subarray(cursor, cursor + 4);
+    cursor += 4;
+  }
+  if (buffer.length - cursor < length) return null;
+  const payload = Buffer.from(buffer.subarray(cursor, cursor + length));
+  if (key) {
+    for (let index = 0; index < payload.length; index += 1) {
+      payload[index] = payload[index]! ^ key[index % 4]!;
+    }
+  }
+  return { frame: { opcode, payload, fin }, next: cursor + length };
+}
+
+type ServerOptions = {
+  onRequest?: (method: string, params: unknown, id: number | string, socket: net.Socket) => void;
+  /** Send these raw frames as soon as the handshake completes. */
+  onOpen?: (send: (frame: Buffer) => void) => void;
+  failUpgrade?: boolean;
+  corruptAccept?: boolean;
+};
+
+/**
+ * A minimal WebSocket JSON-RPC server double. It speaks real RFC 6455 so the
+ * production client is exercised end to end; nothing here is mocked.
+ */
+function createAppServerDouble(socketPath: string, options: ServerOptions = {}) {
+  const sockets = new Set<net.Socket>();
+  const server = net.createServer((socket) => {
+    sockets.add(socket);
+    socket.on("close", () => sockets.delete(socket));
+    let handshakeDone = false;
+    let buffer = Buffer.alloc(0);
+    const send = (frame: Buffer): void => {
+      if (!socket.destroyed) socket.write(frame);
+    };
+
+    socket.on("data", (chunk: Buffer) => {
+      buffer = Buffer.concat([buffer, chunk]);
+      if (!handshakeDone) {
+        const end = buffer.indexOf("\r\n\r\n");
+        if (end < 0) return;
+        const head = buffer.subarray(0, end).toString("utf8");
+        buffer = buffer.subarray(end + 4);
+        const key = /sec-websocket-key:\s*(\S+)/i.exec(head)?.[1] ?? "";
+        if (options.failUpgrade) {
+          socket.write("HTTP/1.1 403 Forbidden\r\ncontent-length: 0\r\n\r\n");
+          socket.end();
+          return;
+        }
+        const accept = options.corruptAccept
+          ? Buffer.from("wrong-accept-value").toString("base64")
+          : crypto.createHash("sha1").update(key + MAGIC).digest("base64");
+        socket.write(
+          "HTTP/1.1 101 Switching Protocols\r\n" +
+            "Upgrade: websocket\r\n" +
+            "Connection: Upgrade\r\n" +
+            `Sec-WebSocket-Accept: ${accept}\r\n\r\n`
+        );
+        handshakeDone = true;
+        options.onOpen?.(send);
+      }
+
+      for (;;) {
+        const decoded = decodeFrame(buffer, 0);
+        if (!decoded) return;
+        buffer = buffer.subarray(decoded.next);
+        const { frame } = decoded;
+        if (frame.opcode === 0x8) {
+          socket.end();
+          return;
+        }
+        if (frame.opcode === 0x9) {
+          send(encodeFrame(0xa, frame.payload));
+          continue;
+        }
+        if (frame.opcode !== 0x1) continue;
+        const message = JSON.parse(frame.payload.toString("utf8")) as {
+          id?: number | string;
+          method?: string;
+          params?: unknown;
+        };
+        if (message.id !== undefined && message.method) {
+          options.onRequest?.(message.method, message.params, message.id, socket);
+        }
+      }
+    });
+    socket.on("error", () => {});
+  });
+
+  return {
+    server,
+    async listen(): Promise<void> {
+      try {
+        fs.unlinkSync(socketPath);
+      } catch {
+        // Socket did not exist yet.
+      }
+      await new Promise<void>((resolve) => server.listen(socketPath, resolve));
+    },
+    async close(): Promise<void> {
+      for (const socket of sockets) socket.destroy();
+      sockets.clear();
+      await new Promise<void>((resolve) => server.close(() => resolve()));
+      try {
+        fs.unlinkSync(socketPath);
+      } catch {
+        // Already removed.
+      }
+    }
+  };
+}
+
+function tempDir(): string {
+  return fs.mkdtempSync(path.join(os.tmpdir(), "rmtcdx-attach-"));
+}
+
+const THREAD = {
+  id: "thread-attached",
+  cwd: "/fixtures/repo",
+  name: "Attached thread",
+  preview: "attached preview",
+  updatedAt: 1_700_000_000,
+  status: { type: "idle" },
+  turns: [
+    {
+      id: "turn-1",
+      status: "completed",
+      items: [{ id: "item-1", type: "agentMessage", text: "from the shared executor" }]
+    }
+  ]
+};
+
+test("attach client completes the handshake and round-trips JSON-RPC over a Unix socket", async () => {
+  const root = tempDir();
+  const socketPath = path.join(root, "executor.sock");
+  const seen: string[] = [];
+  const double = createAppServerDouble(socketPath, {
+    onRequest: (method, _params, id, socket) => {
+      seen.push(method);
+      if (method === "initialize") {
+        socket.write(encodeFrame(0x1, Buffer.from(JSON.stringify({ id, result: { userAgent: "double/1" } }))));
+      }
+      if (method === "thread/list") {
+        socket.write(encodeFrame(0x1, Buffer.from(JSON.stringify({ id, result: { data: [THREAD], nextCursor: null } }))));
+      }
+      if (method === "thread/read") {
+        socket.write(encodeFrame(0x1, Buffer.from(JSON.stringify({ id, result: { thread: THREAD } }))));
+      }
+    }
+  });
+  await double.listen();
+
+  const client = createAttachClient({ url: "ws://localhost/rpc", socketPath }, silent);
+  try {
+    await client.start();
+    assert.equal(client.getState().ready, true);
+    assert.deepEqual(seen, ["initialize"], "handshake must send initialize then initialized");
+
+    const threads = await client.listThreads({ archived: false });
+    assert.equal(threads.length, 1);
+    assert.equal(threads[0]!.id, "thread-attached");
+
+    const thread = await client.readThread("thread-attached", { includeTurns: true });
+    assert.equal(thread.turns?.[0]?.items?.[0]?.type, "agentMessage");
+    assert.ok(seen.includes("thread/list"));
+    assert.ok(seen.includes("thread/read"));
+  } finally {
+    await client.stop();
+    await double.close();
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("attach client never spawns a Codex process and does not need CODEX_HOME", async () => {
+  const root = tempDir();
+  const socketPath = path.join(root, "executor.sock");
+  const double = createAppServerDouble(socketPath, {
+    onRequest: (method, _params, id, socket) => {
+      if (method === "initialize") {
+        socket.write(encodeFrame(0x1, Buffer.from(JSON.stringify({ id, result: {} }))));
+      }
+    }
+  });
+  await double.listen();
+
+  const before = process.env.CODEX_HOME;
+  delete process.env.CODEX_HOME;
+  const client = createAttachClient({ url: "ws://localhost/rpc", socketPath }, silent);
+  try {
+    await client.start();
+    // Attach mode has no child process, so CODEX_HOME is never consulted. If it
+    // had spawned one, the empty CODEX_HOME would have failed the spawn.
+    assert.equal(client.getState().ready, true);
+    assert.equal(process.env.CODEX_HOME, undefined);
+  } finally {
+    await client.stop();
+    if (before !== undefined) process.env.CODEX_HOME = before;
+    await double.close();
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("attach client is fail closed when the endpoint is missing", async () => {
+  const root = tempDir();
+  const socketPath = path.join(root, "absent.sock");
+  const client = createAttachClient(
+    { url: "ws://localhost/rpc", socketPath, handshakeTimeoutMs: 2000 },
+    silent
+  );
+  try {
+    await assert.rejects(client.start(), /ENOENT|ECONNREFUSED|websocket_handshake_timeout/);
+    assert.equal(client.getState().ready, false);
+    // Fail closed: a missing endpoint is never replaced by a second executor.
+    assert.equal(client.getState().restarts, 0);
+  } finally {
+    await client.stop();
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("attach client reports a degraded backend when the executor disappears and never restarts it", async () => {
+  const root = tempDir();
+  const socketPath = path.join(root, "executor.sock");
+  const double = createAppServerDouble(socketPath, {
+    onRequest: (method, _params, id, socket) => {
+      if (method === "initialize") {
+        socket.write(encodeFrame(0x1, Buffer.from(JSON.stringify({ id, result: {} }))));
+      }
+    }
+  });
+  await double.listen();
+
+  const events: Array<{ type: string }> = [];
+  const client = createAttachClient({ url: "ws://localhost/rpc", socketPath }, silent);
+  client.on("event", (event: { type: string }) => events.push(event));
+  try {
+    await client.start();
+    await double.close();
+    const deadline = Date.now() + 2000;
+    while (!events.some((event) => event.type === "backend.degraded") && Date.now() < deadline) {
+      await new Promise((resolve) => setTimeout(resolve, 20));
+    }
+    assert.ok(
+      events.some((event) => event.type === "backend.degraded"),
+      "losing the endpoint must surface backend.degraded"
+    );
+    assert.equal(client.getState().ready, false);
+    // A reconnect attempt would mean a second executor; attach mode must not.
+    await new Promise((resolve) => setTimeout(resolve, 900));
+    assert.equal(client.getState().restarts, 0);
+  } finally {
+    await client.stop();
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("websocket client rejects a non-101 upgrade and a bad accept key", async () => {
+  const root = tempDir();
+  const rejected = path.join(root, "rejected.sock");
+  const rejectedDouble = createAppServerDouble(rejected, { failUpgrade: true });
+  await rejectedDouble.listen();
+  const first = new WebSocketClient({ url: "ws://localhost/rpc", socketPath: rejected });
+  try {
+    await assert.rejects(first.connect(), /websocket_upgrade_rejected_403/);
+  } finally {
+    first.close();
+    await rejectedDouble.close();
+  }
+
+  const corrupt = path.join(root, "corrupt.sock");
+  const corruptDouble = createAppServerDouble(corrupt, { corruptAccept: true });
+  await corruptDouble.listen();
+  const second = new WebSocketClient({ url: "ws://localhost/rpc", socketPath: corrupt });
+  try {
+    await assert.rejects(second.connect(), /websocket_accept_mismatch/);
+  } finally {
+    second.close();
+    await corruptDouble.close();
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("websocket client reassembles fragmented messages, answers pings and honours the payload limit", async () => {
+  const root = tempDir();
+  const socketPath = path.join(root, "frag.sock");
+  const double = createAppServerDouble(socketPath, {
+    onOpen: (send) => {
+      const text = Buffer.from(JSON.stringify({ id: 1, result: { part: "abc" } }));
+      send(encodeFrame(0x1, text.subarray(0, 10), false));
+      send(encodeFrame(0x0, text.subarray(10), true));
+      send(encodeFrame(0x9, Buffer.from("ping-payload")));
+    }
+  });
+  await double.listen();
+
+  const client = new WebSocketClient({ url: "ws://localhost/rpc", socketPath });
+  const messages: string[] = [];
+  client.on("message", (value: unknown) => messages.push(String(value)));
+  try {
+    await client.connect();
+    const deadline = Date.now() + 2000;
+    while (!messages.length && Date.now() < deadline) {
+      await new Promise((resolve) => setTimeout(resolve, 20));
+    }
+    assert.equal(messages[0], JSON.stringify({ id: 1, result: { part: "abc" } }));
+  } finally {
+    client.close();
+    await double.close();
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
