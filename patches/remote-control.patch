+import assert from "node:assert/strict";
+import test from "node:test";
+import { deviceBase, devicePath, deviceStorageKey } from "./device-context";
+
+test("device API, deep links and WebSocket use the selected host prefix", () => {
+  const base = deviceBase("/devices/windows/sessions/thread-1");
+  assert.equal(base, "/devices/windows");
+  assert.equal(devicePath("/api/sessions?q=hi", base), "/devices/windows/api/sessions?q=hi");
+  assert.equal(devicePath("/ws", base), "/devices/windows/ws");
+  assert.equal(devicePath("/api/uploads/image.png", base), "/devices/windows/api/uploads/image.png");
+  assert.equal(devicePath("/devices/windows/api/repos", base), "/devices/windows/api/repos");
+});
+
+test("direct bridge and external/image URLs retain their original behavior", () => {
+  assert.equal(deviceBase("/sessions/thread-1"), "");
+  assert.equal(deviceBase("/devices/"), "");
+  assert.equal(devicePath("/api/repos", ""), "/api/repos");
+  for (const path of ["blob:local-image", "data:image/png;base64,YQ==", "https://example.com/image", "//example.com/image"]) {
+    assert.equal(devicePath(path, "/devices/windows"), path);
+  }
+});
+
+test("same-origin Windows and Mac storage never share selected repo or draft settings", () => {
+  const key = "codex-remote-selected-repo-id";
+  assert.notEqual(deviceStorageKey(key, "/devices/windows"), deviceStorageKey(key, "/devices/mac"));
+  assert.equal(deviceStorageKey(key, ""), key);
+});
