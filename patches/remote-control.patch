+// Attach-mode backend for the independent business worker.
+//
+// Unlike the stdio entry, this client never spawns a Codex process and never
+// reads CODEX_HOME: `WebSocketTransport` only dials an endpoint that the caller
+// has already validated. It is fail closed by design, so the business worker
+// cannot silently replace a missing desktop executor with a second one.
+import type { LoggerLike } from "./codex/types";
+import { RealCodexClient } from "./codex/real-client";
+import { WebSocketTransport } from "./codex/transport";
+
+export { RealCodexClient } from "./codex/real-client";
+export { WebSocketTransport } from "./codex/transport";
+export { WebSocketClient } from "./codex/websocket-client";
+
+export type AttachClientOptions = {
+  /** Websocket URL of the already-running app-server, e.g. `ws://localhost/rpc`. */
+  url: string;
+  /** Dial this Unix socket instead of TCP. */
+  socketPath?: string;
+  handshakeTimeoutMs?: number;
+  maxPayloadBytes?: number;
+};
+
+/**
+ * Builds a Codex client bound to an existing executor over a validated
+ * WebSocket endpoint.
+ */
+export function createAttachClient(
+  options: AttachClientOptions,
+  logger: LoggerLike
+): RealCodexClient {
+  const transport = new WebSocketTransport({
+    url: options.url,
+    ...(options.socketPath ? { socketPath: options.socketPath } : {}),
+    ...(options.handshakeTimeoutMs ? { handshakeTimeoutMs: options.handshakeTimeoutMs } : {}),
+    ...(options.maxPayloadBytes ? { maxPayloadBytes: options.maxPayloadBytes } : {}),
+    logger
+  });
+  return new RealCodexClient(logger, undefined, undefined, transport);
+}
