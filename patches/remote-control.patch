+import assert from "node:assert/strict";
+import test from "node:test";
+import { MutationReceipts, mutationFingerprint } from "./mutation-receipts";
+
+test("lost response and page restart retain the original operation ID", async () => {
+  const records = new Map<string, string>();
+  const storage = {
+    getItem: (key: string) => records.get(key) ?? null,
+    setItem: (key: string, value: string) => { records.set(key, value); },
+    removeItem: (key: string) => { records.delete(key); }
+  };
+  const fingerprint = await mutationFingerprint("POST", "/devices/windows/api/runs", '{"prompt":"private content"}');
+  const first = new MutationReceipts(storage).begin(fingerprint);
+  // Reload can happen before fetch settles. Failures never clear a dispatch ID;
+  // later offline/auth failures cannot establish whether it executed earlier.
+  assert.equal(new MutationReceipts(storage).begin(fingerprint), first);
+  assert.ok(!JSON.stringify([...records]).includes("private content"));
+  new MutationReceipts(storage).complete(fingerprint);
+  assert.notEqual(new MutationReceipts(storage).begin(fingerprint), first);
+});
+
+test("same prompt on different machines and changed payload are different operations", async () => {
+  const windows = await mutationFingerprint("POST", "/devices/windows/api/runs", "same prompt");
+  assert.notEqual(windows, await mutationFingerprint("POST", "/devices/mac/api/runs", "same prompt"));
+  assert.notEqual(windows, await mutationFingerprint("POST", "/devices/windows/api/runs", "changed prompt"));
+});
+
+test("storage failure prevents dispatch rather than losing deduplication state", () => {
+  const receipts = new MutationReceipts({ getItem: () => null, setItem: () => { throw new Error("storage denied"); }, removeItem: () => {} });
+  assert.throws(() => receipts.begin("fingerprint"), /storage denied/);
+});
diff --git a/apps/web/src/api/mutation-receipts.ts b/apps/web/src/api/mutation-receipts.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/src/api/mutation-receipts.ts
@@ -0,0 +1,27 @@
+type ReceiptStorage = Pick<Storage, "getItem" | "setItem" | "removeItem">;
+
+/** Stores only a digest and request ID, never the prompt or attachments. */
+export class MutationReceipts {
+  constructor(private readonly storage: ReceiptStorage) {}
+
+  begin(fingerprint: string) {
+    const key = `rmtagt-pending:${fingerprint}`;
+    const previous = this.storage.getItem(key);
+    if (previous) return previous.split("|")[0]!;
+    const id = crypto.randomUUID();
+    // Persist before dispatch. Storage failure must prevent an unsafe send.
+    this.storage.setItem(key, id);
+    return id;
+  }
+
+  complete(fingerprint: string) {
+    this.storage.removeItem(`rmtagt-pending:${fingerprint}`);
+  }
+
+}
+
+export async function mutationFingerprint(method: string, path: string, body: BodyInit | null | undefined) {
+  if (body != null && typeof body !== "string") throw new Error("Unsupported mutation body");
+  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(`${method}\n${path}\n${body ?? ""}`));
+  return Array.from(new Uint8Array(digest), (value) => value.toString(16).padStart(2, "0")).join("");
+}
