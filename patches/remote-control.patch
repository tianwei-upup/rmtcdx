+++ b/apps/web/src/app/device-context.ts
@@ -0,0 +1,13 @@
+/** One document/WebView owns one device; direct local bridge URLs remain supported. */
+export function deviceBase(pathname = typeof window === "undefined" ? "/" : window.location.pathname) {
+  return pathname.match(/^\/devices\/([A-Za-z0-9_-]+)(?:\/|$)/)?.[0].replace(/\/$/, "") ?? "";
+}
+
+export function devicePath(path: string, base = deviceBase()) {
+  if (!base || !path.startsWith("/") || path.startsWith("//") || path.startsWith(`${base}/`)) return path;
+  return `${base}${path}`;
+}
+
+export function deviceStorageKey(key: string, base = deviceBase()) {
+  return base ? `${base}:${key}` : key;
+}
