+import assert from "node:assert/strict";
+import test from "node:test";
+import { RealCodexClient } from "../../src/codex/real-client";
+
+test("first turn on a newly loaded thread does not resume its nonexistent history", async () => {
+  const client = new RealCodexClient({ info() {}, warn() {}, error() {}, debug() {} });
+  const methods: string[] = [];
+  let hasTurn = false;
+  Reflect.set(client, "ensureReady", async () => {});
+  Reflect.set(client, "request", async (method: string) => {
+    methods.push(method);
+    if (method === "thread/start") return { thread: { id: "empty-thread" } };
+    if (method === "thread/resume") {
+      if (!hasTurn) throw new Error("list_turns is not supported yet");
+      return { thread: { id: "empty-thread" } };
+    }
+    if (method === "turn/start") { hasTurn = true; return { turn: { id: `turn-${methods.length}` } }; }
+    throw new Error(`Unexpected method ${method}`);
+  });
+  const { threadId } = await client.createThread(process.cwd());
+  await client.startRun({ runId: "first", sessionId: threadId, threadId, cwd: process.cwd(), input: [] });
+  assert.deepEqual(methods, ["thread/start", "turn/start"]);
+  await client.startRun({ runId: "second", sessionId: threadId, threadId, cwd: process.cwd(), input: [] });
+  assert.deepEqual(methods, ["thread/start", "turn/start", "thread/resume", "turn/start"]);
+});
+
+test("new rollout metadata flush race retries only reads and preserves the requested history mode", async () => {
+  const client = new RealCodexClient({ info() {}, warn() {}, error() {}, debug() {} });
+  Reflect.set(client, "ensureReady", async () => {});
+  let attempts = 0;
+  Reflect.set(client, "request", async (method: string, params: { threadId: string; includeTurns: boolean }) => {
+    assert.equal(method, "thread/read");
+    assert.deepEqual(params, { threadId: "new-thread", includeTurns: false });
+    if (++attempts < 3) throw new Error("failed to read session metadata /fixture/new.jsonl: rollout at /fixture/new.jsonl is empty");
+    return { thread: { id: "new-thread" } };
+  });
+  assert.equal((await client.readThread("new-thread", { includeTurns: false })).id, "new-thread");
+  assert.equal(attempts, 3);
+});
+
+test("persistent empty rollout and unrelated errors remain visible", async () => {
+  const client = new RealCodexClient({ info() {}, warn() {}, error() {}, debug() {} });
+  Reflect.set(client, "ensureReady", async () => {});
